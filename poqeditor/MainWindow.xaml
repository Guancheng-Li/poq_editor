<Window x:Class="PoqEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="秦殇内存修改器 (PoqEditor) - 64位重制版" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen" FontSize="14"
        Loaded="Window_Loaded">
  <DockPanel>
    <!-- 顶部：进程选择 + 初始化 -->
    <GroupBox Header="进程" DockPanel.Dock="Top" Margin="6" Padding="6">
      <DockPanel>
        <Button x:Name="BtnRefresh" Content="刷新进程" Click="BtnRefresh_Click" DockPanel.Dock="Right"/>
        <Button x:Name="BtnInit" Content="初始化" Click="BtnInit_Click" DockPanel.Dock="Right" FontWeight="Bold"/>
        <TextBlock Text="选择进程：" VerticalAlignment="Center" Margin="2"/>
        <ComboBox x:Name="CbProcess" MinWidth="320" IsEditable="True"/>
      </DockPanel>
    </GroupBox>

    <!-- 状态栏 -->
    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock x:Name="StatusText" Text="就绪。请以管理员身份运行，并在游戏中拾起要修改的物品。"/>
    </StatusBar>

    <TabControl Margin="6">
      <!-- ===== 物品修改 ===== -->
      <TabItem Header="物品修改">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <GroupBox Header="基础属性" Grid.Row="0" Margin="4" Padding="6">
            <WrapPanel x:Name="BasicFieldsPanel"/>
          </GroupBox>

          <GroupBox Header="属性列表（46 条模板）" Grid.Row="1" Margin="4" Padding="6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="2">
                <Button x:Name="BtnRead" Content="读取属性" Click="BtnRead_Click" FontWeight="Bold"/>
                <Button x:Name="BtnLoadTpl" Content="从模板读取" Click="BtnLoadTpl_Click"/>
                <Button x:Name="BtnSave" Content="保存属性" Click="BtnSave_Click" FontWeight="Bold"/>
                <Button x:Name="BtnAdd" Content="添加" Click="BtnAdd_Click"/>
                <Button x:Name="BtnDel" Content="删除" Click="BtnDel_Click"/>
                <Button x:Name="BtnClear" Content="清空" Click="BtnClear_Click"/>
                <TextBlock x:Name="LbCount" Text="属性数：0" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </StackPanel>
              <DataGrid x:Name="PropGrid" Grid.Row="1" AutoGenerateColumns="False"
                        ItemsSource="{Binding}" CanUserAddRows="True" Margin="2"
                        HeadersVisibility="Column" GridLinesVisibility="All">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="地址(写入位置)"   Binding="{Binding Address}"  Width="140"/>
                  <DataGridTextColumn Header="Index(属性代码)" Binding="{Binding Index}"    Width="120"/>
                  <DataGridTextColumn Header="Num(数值)"       Binding="{Binding Num}"      Width="120"/>
                  <DataGridTextColumn Header="Color(颜色)"     Binding="{Binding Color}"    Width="110"/>
                  <DataGridTextColumn Header="Precent(百分比)" Binding="{Binding Precent}"  Width="120"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </GroupBox>
        </Grid>
      </TabItem>

      <!-- ===== 内存查看 ===== -->
      <TabItem Header="内存查看">
        <Grid Margin="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="2">
            <TextBlock Text="地址(0x...)" VerticalAlignment="Center"/>
            <TextBox x:Name="RawAddr" Width="160" Text="0x901FF0"/>
            <TextBlock Text="长度" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBox x:Name="RawSize" Width="60" Text="64"/>
            <Button x:Name="BtnRawRead" Content="读取" Click="BtnRawRead_Click"/>
            <Button x:Name="BtnRawWrite" Content="写入" Click="BtnRawWrite_Click"/>
          </StackPanel>
          <TextBox x:Name="RawHex" Grid.Row="1" FontFamily="Consolas" IsReadOnly="False"
                   AcceptsReturn="True" HorizontalScrollBarVisibility="Auto"
                   TextWrapping="NoWrap" Margin="2"/>
          <TextBlock Grid.Row="2" Margin="2" Foreground="Gray"
                     Text="写入时：上面 hex 文本框里每行 &#34;地址: 十六进制字节&#34; 或纯十六进制字节均可，程序会解析后写入。读取用于校准偏移。"/>
        </Grid>
      </TabItem>

      <!-- ===== 偏移配置 ===== -->
      <TabItem Header="偏移配置">
        <ScrollViewer Margin="6">
          <StackPanel x:Name="CfgPanel"/>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
